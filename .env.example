# Local development works with no configuration: SQLite, console OTP codes, dev-only keys.
DATABASE_URL=sqlite:///./app.db
# Production: postgresql://user:password@host:5432/dbname

# APP_ENV=production refuses to start with dev keys or OTP_SENDER=console.
APP_ENV=dev

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
BLIND_INDEX_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: ENCRYPTION_KEY=new_key,old_key (first encrypts, all decrypt)
ENCRYPTION_KEY=

# OTP delivery: console (dev only, prints codes to the log) | smtp (email only; SMS needs a provider adapter)
OTP_SENDER=console
# Removal letters: smtp | fake (records instead of sending)
REMOVAL_SENDER=fake
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1
REMOVAL_REPLY_TO=

# Demo scanner reading a local JSON file (no network). Leave empty to disable.
FIXTURE_SCANNER_PATH=

RATE_LIMIT_PER_MINUTE=120
